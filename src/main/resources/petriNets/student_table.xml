				</layout>
			</dataRef>
			<dataRef>
				<id>my_working_relations</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>1</rows>
					<cols>4</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="assign">
			<id>update_assign</id>
			<actions phase="pre">
				<action id="action7">
					<![CDATA[
					referenced_cases: f.referenced_cases,
					working_referenced_cases: f.working_referenced_cases,
					working_birthday: f.working_birthday,
					birthday: f.birthday,
					working_surname: f.working_surname,
					surname: f.surname,
					working_name: f.working_name,
					name: f.name;
					change working_name value { name.value; }
					change working_surname value { surname.value; }
					change working_birthday value { birthday.value; }
					def possible_references = findCases { it.processIdentifier.eq(workspace + "course_table").and(it.activePlaces.get("available_to_be_referenced").eq(1))}.collectEntries { 
					                        [(it.stringId): it.title + " " + it.stringId] 
					                    }
					change working_referenced_cases options {possible_references}
					change working_referenced_cases value { referenced_cases.value; }
					]]>
				</action>
			</actions>
		</event>
		<event type="finish">
			<id>update_finish</id>
			<actions phase="pre">
				<action id="action8">
					<![CDATA[
					my_relations_data: f.my_relations_data,
					working_referenced_cases: f.working_referenced_cases,
					referenced_cases: f.referenced_cases,
					working_birthday: f.working_birthday,
					birthday: f.birthday,
					working_surname: f.working_surname,
					surname: f.surname,
					working_name: f.working_name,
					name: f.name;
					change name value { working_name.value; }
					change surname value { working_surname.value; }
					change birthday value { working_birthday.value; }
					def added_references = working_referenced_cases.value - referenced_cases.value
					added_references.each { reference_id ->
					def reference_case = findCase({it._id.eq(reference_id)});
					setData("interface_data", reference_case, ["reference_to_add": ["value": my_id.value, "type": "text"]]);
					}
					def removed_references = referenced_cases.value - working_referenced_cases.value
					removed_references.each { reference_id ->
					def reference_case = findCase({it._id.eq(reference_id)});
					setData("interface_data", reference_case, ["reference_to_remove": ["value": my_id.value, "type": "text"]]);
					}
					change referenced_cases value { working_referenced_cases.value; }
					def reference_data_task_ids = findTasks{it.caseId.in(referenced_cases.value).and(it.transitionId.eq("data"))}.collect{it.stringId}
					change my_relations_data value { reference_data_task_ids }
					]]>
				</action>
			</actions>
		</event>
