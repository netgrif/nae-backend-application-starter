	<data type="text">
		<id>name</id>
		<title>Name</title>
	</data>
	<data type="text">
		<id>reference_to_add</id>
		<title>Reference to add</title>
		<event type="set">
			<id>reference_to_add_set</id>
			<actions phase="post">
				<action id="action5">
					<![CDATA[
					referenced_cases: f.referenced_cases,
					reference_to_add: f.reference_to_add;
					if (reference_to_add.value !in referenced_cases.value) {
					change referenced_cases value { referenced_cases.value +  reference_to_add.value}}
					]]>
				</action>
			</actions>
		</event>
	</data>
	<data type="text">
		<id>reference_to_remove</id>
		<title>Reference to remove</title>
		<event type="set">
			<id>reference_to_remove_set</id>
			<actions phase="post">
				<action id="action6">
					<![CDATA[
					referenced_cases: f.referenced_cases,
					reference_to_remove: f.reference_to_remove;
					if (reference_to_remove.value in referenced_cases.value) {
					change referenced_cases value { referenced_cases.value -  reference_to_remove.value}}
					]]>
				</action>
			</actions>
		</event>
	</data>
