<document xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://petriflow.com/petriflow.schema.xsd">
	<id>student_table</id>
	<version>1.0.0</version>
	<initials>STD</initials>
	<title>Student table without lock one read</title>
	<icon>device_hub</icon>
	<defaultRole>true</defaultRole>
	<anonymousRole>true</anonymousRole>
	<transitionRole>false</transitionRole>
	<caseEvents>
		<event type="create">
			<id>new_model_create</id>
			<actions phase="post">
				<action id="action4">
					<![CDATA[
					my_id: f.my_id;
					change my_id value { useCase.stringId; }
					
					log.info("set my id")
					
					]]>
				</action>
			</actions>
		</event>
		<event type="delete">
			<id>student_table_without_lock_one_read_delete</id>
			<actions phase="pre">
				<action id="action9">
					<![CDATA[
					my_id: f.my_id,
					referenced_cases: f.referenced_cases;
					referenced_cases.each { reference_id ->
					def reference_case = findCase({it._id.eq(reference_id)});
					setData("interface_data", reference_case, ["reference_to_remove": ["value": my_id.value, "type": "text"]]);
					}
					]]>
				</action>
			</actions>
		</event>
	</caseEvents>
