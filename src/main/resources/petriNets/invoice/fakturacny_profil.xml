	<function scope="process" name="loadSubject">
		<![CDATA[
		{ search_ico, data_select, data_select_cache ->
			subjects = loadSubjectFromOrsr(search_ico, data_select, data_select_cache)
			if (!subjects) {
				return
			}
			change data_select options { subjects }
			if (subjects && subjects.size() == 1) {
				change data_select value { data_select.options.keySet()[0] }
			}
		}
		]]>
	</function>
	<function scope="process" name="loadSubjectFromOrsr">
		<![CDATA[
		{ search_ico, data_select, data_select_cache ->
			try {
				if (search_ico.value) {
					def subject = orsr(byIco, search_ico.value)
					if (!subject) {
						return [:]
					}
					def address = "$subject.street $subject.streetNumber, $subject.city, $subject.postalCode" as String
					change data_select_cache options { [(subject.id): (subject.name + ";#;" + address + ";#;" + "SK")] }
					return [(subject.id): (subject.id + ", " + subject.name)]
				}
			} catch (Exception e) {
				log.error("Failed to reach ORSR for $search_ico.value", e)
			}
			return [:]
		}
		]]>
	</function>
