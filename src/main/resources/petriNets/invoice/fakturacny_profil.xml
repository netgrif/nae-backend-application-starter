	<data type="enumeration_map">
		<id>data_select</id>
		<title>Vybrať dodávateľa</title>
		<event type="set">
			<actions phase="post">
				<action id="action_0">
					<![CDATA[
					nazov: f.nazov,
					ico: f.ico,
					sidlo: f.sidlo,
					krajina: f.krajina,
					data_select: f.data_select,
					data_select_cache: f.data_select_cache;

					if (data_select.value == null) {
						change nazov value { "" }
						change sidlo value { "" }
						change krajina value { null }
						change ico value { "" }
						return
					}

					def dodData = (data_select_cache.options[data_select.value] as String)?.split(";#;")
					change nazov value { dodData[0] }
					change sidlo value { dodData[1] }
					change krajina value { dodData.size() > 2 ? (dodData[2] == "CZ" ? "ČR" : dodData[2]) : null }
					change ico value { data_select.value }
					]]>
				</action>
			</actions>
		</event>
	</data>
