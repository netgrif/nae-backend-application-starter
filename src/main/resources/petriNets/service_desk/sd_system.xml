	<function scope="process" name="addToHtml">
		<![CDATA[
		{txt ->
		    def user = userService.getLoggedUser().getFullName();
		    def creation_date = java.time.LocalDateTime.now().format(
		        java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy HH:mm")
		        );
		    def block = 
		    "<strong>"+user+"</strong>  |  " +
		    "<strong>"+ creation_date +"</strong>" +
		    "<p style=\"margin: 0; word-wrap: break-word; overflow-wrap: break-word;\">" +
		    txt.trim() +
		    "</p>";
		    return block
		}
		]]>
	</function>
