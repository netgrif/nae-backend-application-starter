	<data type="enumeration_map" immediate="true">
		<id>category</id>
		<title>Category</title>
		<options>
			<option key="change">Change Request</option>
			<option key="incident">Incident Bug</option>
			<option key="service">️Service Request</option>
		</options>
		<event type="set">
			<id>category_set</id>
			<actions phase="post">
				<action id="action24">
					<![CDATA[
					category: f.category,
					incident_but: f.incident_but,
					change_req_but: f.change_req_but,
					service_req_but: f.service_req_but,
					form_ref: f.form_ref;
					switch(category.value){
					    case "incident":
					        def myTask = findTask(UseCase.tasks.find { it.transition == "t14" }.task)
					        change form_ref value { [myTask.stringId]; }
					        break;
					    case "change":
					        def myTask = findTask(UseCase.tasks.find { it.transition == "t15" }.task)
					        change form_ref value { [myTask.stringId]; }
					        break;
					    case "service":
					        def myTask = findTask(UseCase.tasks.find { it.transition == "t13" }.task)
					        change form_ref value { [myTask.stringId]; }
					        break;
					    default:
					        change form_ref value { []; }
					        break;
					}
					make service_req_but, hidden on transitions when { true }
					make change_req_but, hidden on transitions when { true}
					make incident_but, hidden on transitions when { true }
					]]>
				</action>
			</actions>
		</event>
	</data>
